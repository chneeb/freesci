build/
build-*/

# Device serial captures pulled off the Pico while debugging. Deliberately
# NARROW patterns rather than *.log or PICO_*.md: this repo commits assessment
# docs (PICO_SQ3_SRAM_CEILING_ASSESSMENT.md, PICO_SRAM_PSRAM_REVIEW.md), so a
# wildcard over that category would silently hide files that belong in git.
pico*.log
asan.log

# picodiff/visdiff build products (the harnesses are sources, these are not)
tests/picodiff/pico_pic.c
tests/picodiff/pico_pic.o
tests/picodiff/picodiff
tests/picodiff/visdiff
tests/drvdiff/drvdiff_unpacked
tests/drvdiff/drvdiff_packed
tests/drvdiff/*.bin
tests/drvdiff/*.ppm

# decompdiff harness build products (stream_decomp.c is a COPY of decompress0.c)
tests/decompdiff/stream_decomp.c
tests/decompdiff/stream_decomp.o
tests/decompdiff/decompdiff
tests/decompdiff/stream_decomp01.c
tests/decompdiff/stream_decomp01.o
# viewdiff harness build products (pico_view1.c is a COPY of sci_view_1.c)
tests/viewdiff/pico_view1.c
tests/viewdiff/pico_view1.o
tests/viewdiff/pico_pixmap.o
tests/viewdiff/viewdiff
